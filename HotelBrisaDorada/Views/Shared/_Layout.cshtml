@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accion = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Activo(string c, string a) => controlador == c && accion == a ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Hotel Brisa Dorada: alojamiento con ambiente tropical en Guatapé, Antioquia. Consulta disponibilidad y reserva tu estadía." />
    <title>@ViewData["Title"] - Hotel Brisa Dorada</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark barra">
            <div class="container">
                <a class="navbar-brand marca" asp-controller="Home" asp-action="Index">Brisa <span>Dorada</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @Activo("Home", "Index")" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "Habitaciones" && accion != "Tarifas" ? "active" : "")" asp-controller="Habitaciones" asp-action="Index">Habitaciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Home", "Servicios")" asp-controller="Home" asp-action="Servicios">Servicios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Habitaciones", "Tarifas")" asp-controller="Habitaciones" asp-action="Tarifas">Tarifas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Reservas", "Disponibilidad")" asp-controller="Reservas" asp-action="Disponibilidad">Disponibilidad</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Home", "Contacto")" asp-controller="Home" asp-action="Contacto">Contacto</a>
                        </li>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <a class="btn btn-dorado btn-sm px-3" asp-controller="Reservas" asp-action="Create">Reservar</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="pie">
        <div class="container">
            <div class="row g-4 py-5">
                <div class="col-lg-5">
                    <a class="marca marca-pie" asp-controller="Home" asp-action="Index">Brisa <span>Dorada</span></a>
                    <p class="mt-3 mb-0 pie-texto">Un descanso que se convierte en recuerdo. Alojamiento con ambiente tropical en Guatapé, Antioquia.</p>
                </div>
                <div class="col-6 col-lg-3">
                    <h2 class="pie-titulo">Explora</h2>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-controller="Habitaciones" asp-action="Index">Habitaciones</a></li>
                        <li><a asp-controller="Home" asp-action="Servicios">Servicios</a></li>
                        <li><a asp-controller="Habitaciones" asp-action="Tarifas">Tarifas</a></li>
                        <li><a asp-controller="Reservas" asp-action="Disponibilidad">Disponibilidad</a></li>
                        <li><a asp-controller="Reservas" asp-action="Create">Reservar</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h2 class="pie-titulo">Contacto</h2>
                    <ul class="list-unstyled mb-0 pie-texto">
                        <li><i class="bi bi-geo-alt me-2"></i>Guatapé, Antioquia, Colombia</li>
                        <li><i class="bi bi-envelope me-2"></i>reservas&#64;brisadorada.com</li>
                        <li><i class="bi bi-telephone me-2"></i>+57 300 000 0000</li>
                    </ul>
                </div>
            </div>
            <div class="pie-base">
                <span>&copy; @DateTime.Now.Year Hotel Brisa Dorada. Proyecto académico de Programación Web; los datos de contacto son ficticios.</span>
                <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
