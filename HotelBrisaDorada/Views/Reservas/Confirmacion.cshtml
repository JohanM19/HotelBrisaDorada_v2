@model ConfirmacionViewModel
@{
    ViewData["Title"] = "Reserva registrada";
    var r = Model.Reserva;
    var c = Model.Cotizacion;
}

<section class="seccion">
    <div class="container">
        <div class="confirmacion">
            <div class="text-center mb-4">
                <span class="confirmacion-icono"><i class="bi bi-check-lg"></i></span>
                <h1 class="mt-3">Solicitud registrada</h1>
                <p class="text-secondary mb-1">Gracias, @r.Nombre. Te contactaremos al correo @r.Correo para confirmar tu reserva.</p>
                <p class="mb-0">Tu código de reserva es <strong class="codigo">@r.Codigo</strong></p>
            </div>

            <div class="formulario">
                <h2 class="h5 mb-3">Resumen de la estadía</h2>
                <dl class="resumen">
                    <div><dt>Habitación</dt><dd>@Model.Habitacion.Nombre</dd></div>
                    <div><dt>Llegada</dt><dd>@r.FechaEntrada.Fecha()</dd></div>
                    <div><dt>Salida</dt><dd>@r.FechaSalida.Fecha()</dd></div>
                    <div><dt>Duración</dt><dd>@Formato.Plural(c.Noches, "noche", "noches")</dd></div>
                    <div><dt>Huéspedes</dt><dd>@Formato.Plural(r.Personas, "persona", "personas")</dd></div>
                </dl>

                <h2 class="h5 mt-4 mb-3">Detalle del valor</h2>
                <dl class="resumen">
                    <div><dt>Alojamiento</dt><dd>@c.Alojamiento.Cop()</dd></div>
                    @if (c.PersonasAdicionales > 0)
                    {
                        <div><dt>Personas adicionales</dt><dd>@c.PersonasAdicionales.Cop()</dd></div>
                    }
                    @if (c.Desayuno > 0)
                    {
                        <div><dt>Desayuno</dt><dd>@c.Desayuno.Cop()</dd></div>
                    }
                    <div class="resumen-total"><dt>Total estimado</dt><dd>@c.Total.Cop()</dd></div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(r.Comentarios))
                {
                    <p class="small text-secondary mt-3 mb-0">Comentarios: @r.Comentarios</p>
                }
            </div>

            <div class="d-flex justify-content-center gap-2 flex-wrap mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-selva">Volver al inicio</a>
                <a asp-controller="Reservas" asp-action="Create" class="btn btn-outline-selva">Hacer otra reserva</a>
            </div>
        </div>
    </div>
</section>
